# API Configuration
VITE_API_URL=http://127.0.0.1:8080/api/v1

# Tolgee i18n — platform URL + a READ-ONLY API key. Used to read translations
# live from the Tolgee REST API in development. Production builds use the bundled
# static translations, so these can be left empty.
VITE_TOLGEE_API_URL=
VITE_TOLGEE_API_KEY=
